# =========================================================
# CONFIG
# =========================================================

@dataclass
class SydeConfig:

    # Core
    hidden_size: int = 512
    world_dim: int = 512
    memory_dim: int = 512

    # Civilization
    num_civilizations: int = 16
    civilization_heads: int = 8

    # Recursive hierarchy
    recursive_depth: int = 4
    abstraction_layers: int = 3

    # Trust system
    trust_decay: float = 0.992
    trust_growth: float = 0.003
    trust_min: float = 0.05
    trust_max: float = 1.0

    # Stability
    divergence_threshold: float = 2.5
    convergence_rate: float = 0.03
    entropy_regularization: float = 0.002

    # Memory
    episodic_memory_size: int = 2048
    civilization_memory_size: int = 1024
    world_memory_size: int = 4096

    # Evolution
    mutation_scale: float = 0.01
    adaptation_rate: float = 0.02

    # Simulation
    imagination_steps: int = 6

    # Safety
    collapse_threshold: float = 8.0
    emergency_reset_ratio: float = 0.25


# =========================================================
# UTILITY
# =========================================================

class RMSNorm(nn.Module):

    def __init__(self, dim, eps=1e-8):
        super().__init__()
        self.eps = eps
        self.scale = nn.Parameter(torch.ones(dim))

    def forward(self, x):
        norm = x.norm(dim=-1, keepdim=True)
        return x / (norm + self.eps) * self.scale


# =========================================================
# TRUST ENGINE
# =========================================================

class TrustEngine(nn.Module):

    """
    Dynamic trust evolution system
    Prevents unstable civilization dominance
    """

    def __init__(self, config):
        super().__init__()

        self.config = config

    def forward(
        self,
        trust,
        coherence,
        stability,
        novelty
    ):

        delta = (
            coherence * 0.4
            + stability * 0.4
            + novelty * 0.2
        )

        trust = (
            trust * self.config.trust_decay
            + delta * self.config.trust_growth
        )

        trust = torch.clamp(
            trust,
            self.config.trust_min,
            self.config.trust_max
        )

        return trust


