@dataclass
class SydeConfig:

    # Core
    hidden_size: int = 256
    latent_size: int = 256
    memory_tokens: int = 128

    # Civilization
    num_civilizations: int = 12
    agents_per_civ: int = 8

    # Governance
    governance_heads: int = 8
    recursive_depth: int = 4

    # Persistent history
    history_length: int = 64

    # World
    world_dim: int = 256
